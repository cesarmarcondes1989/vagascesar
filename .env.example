# Copie para .env.local (dev) e cadastre as mesmas chaves na Vercel (Settings → Environment Variables).
# Nunca commite o .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude → https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: troca o modelo sem mexer no código
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vagas reais (Google Jobs via SerpAPI) → https://serpapi.com/manage-api-key
# Sem esta chave o app roda em MODO DEMO com vagas de exemplo.
SERPAPI_KEY=

# Quem pode entrar (separe por vírgula). Vazio = qualquer e-mail recebe link.
ALLOWED_EMAILS=contato@cesar-marcondes.com
