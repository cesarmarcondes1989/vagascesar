# Copie para .env.local (dev) e cadastre as mesmas chaves na Vercel (Settings → Environment Variables).
# Nunca commite o .env.local.

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (service_role / secret). Fica só no servidor, NUNCA no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Claude → https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: troca o modelo sem mexer no código
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vagas reais (Google Jobs via SerpAPI) → https://serpapi.com/manage-api-key
# Sem esta chave o app roda em MODO DEMO com vagas de exemplo.
SERPAPI_KEY=

# Opcional: senha simples para abrir o app (sem e-mail). Vazio = app aberto para quem tiver a URL.
APP_PASSWORD=
